# Copia este archivo como apps/api/.env y apps/web/.env.local (ver README).

# ---------- API (apps/api/.env) ----------
# Local con docker compose. En Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://mandaito:mandaito@localhost:5433/mandaito?schema=public"
PORT=3001
# Opcional: si se define, el API exige este valor en la cabecera x-api-key.
INTERNAL_API_KEY=""
# Opcional: orígenes CORS separados por coma (solo si el API tiene dominio público).
CORS_ORIGIN=""

# ---------- Web (apps/web/.env.local) ----------
# Número de WhatsApp con código de país, solo dígitos (ej. 584121234567).
WHATSAPP_NUMBER=""
# URL pública del sitio (para SEO / Open Graph).
SITE_URL="http://localhost:3000"
# Opcionales: Google Analytics 4 (G-XXXXXXX) y Pixel de Meta (solo dígitos).
GA_MEASUREMENT_ID=""
META_PIXEL_ID=""
# URL del API. Local: http://localhost:3001 · Railway: http://${{api.RAILWAY_PRIVATE_DOMAIN}}:${{api.PORT}}
API_INTERNAL_URL="http://localhost:3001"
# Debe coincidir con INTERNAL_API_KEY del API (si se usa).
INTERNAL_API_KEY=""
